    "Key": "",
    "ExpiryMinutes": 60
  },
  "Llm": {
    "BaseUrl": "https://api.openai.com/",
    "Model": "gpt-4.1-mini",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "Minio": {
    "Endpoint": "",
