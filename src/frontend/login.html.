
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartDroneDelivery - Login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f7fa;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }

    .login-box {
      width: 320px;
      padding: 25px;
      background: white;
      border: 1px solid #aaa;
      border-radius: 12px;
    }

    h2, p { text-align: center; }

    input, button {
      box-sizing: border-box;
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      border-radius: 9px;
      font-size: 14px;
    }

    input { border: 1px solid #aaa; }
    button {
      border: none;
      background: #4b91ed;
      color: white;
      cursor: pointer;
    }

    a { color: #168bff; }
  </style>
</head>
<body>
  <main class="login-box">
    <h2>Smart Drone Delivery</h2>
    <p>AI-powered Drone Delivery</p>

    <form>
      <input type="email" placeholder="Enter your email" required>
      <input type="password" placeholder="Enter your password" required>
      <button type="submit">Login</button>
    </form>

    <p><a href="register.html">Create an account</a></p>
  </main>
</body>
</html>
